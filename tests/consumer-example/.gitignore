.devenv/
.devenv.flake.nix
devenv.lock
.venv/
.pre-commit-config.yaml
# docman's enterShell (docs-init) scaffolds these into a doc-enabled consumer. In a
# real repo they're source you commit; in this throwaway fixture they're generated
# noise — ignore them so the fixture stays focused on repoman wiring.
.docman/
docs/
snippets/
.markdownlint.jsonc
.typos.toml
.docman/site/
.docman/.cache/

# Agent-files convention: .agents/skills/ + AGENTS.md + CLAUDE.md tracked;
# the rest of .agents/ (tool runtime state) stays ignored (.agents/ dual-use).
.agents/**
!.agents/skills/
!.agents/skills/**
!.agents/devenv/
!.agents/devenv/**
!AGENTS.md
!CLAUDE.md
